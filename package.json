{
  "name": "easy",
  "displayName": "Easy Language",
  "description": "A VS Code language for visual note-taking with colored tags (#todo, #doing, #done), formatted titles (#, ##, ###), date insertion, and keyboard shortcuts — designed for fast, organized plain-text notes.",
  "version": "0.2.0",
  "publisher": "JorgeDuarte",
  "author": {
    "name": "Jorge Duarte"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/EasyLanguage"
  },
  "engines": {
    "vscode": "^1.52.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "notes",
    "todo",
    "productivity",
    "easy",
    "color",
    "task management"
  ],
  "activationEvents": [
    "onLanguage:easy",
    "onLanguage:plaintext"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "easy",
        "path": "./easySnippets.json"
      }
    ],
    "languages": [
      {
        "id": "easy",
        "aliases": [
          "Easy",
          "easy"
        ],
        "extensions": [
          ".easy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "easy",
        "scopeName": "source.easy",
        "path": "./syntaxes/easy.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Easy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/easy-color-theme.json"
      },
      {
        "label": "Easy Light",
        "uiTheme": "vs",
        "path": "./themes/easy-light-color-theme.json"
      }
    ],
    "keybindings": [
      {
        "command": "extension.insertText",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.insertSquare",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.insertCurrentDate",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus"
      },
      {
        "command": "easyLanguage.cycleTaskStatus",
        "key": "alt+s",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "extension.insertText",
        "title": "Insert Check Mark"
      },
      {
        "command": "extension.insertSquare",
        "title": "Insert Square"
      },
      {
        "command": "extension.insertCurrentDate",
        "title": "Insert Current Date"
      },
      {
        "command": "easyLanguage.showTaskStats",
        "title": "Easy: Mostrar estadísticas de tareas"
      },
      {
        "command": "easyLanguage.nextTask",
        "title": "Easy: Ir a la tarea siguiente"
      },
      {
        "command": "easyLanguage.prevTask",
        "title": "Easy: Ir a la tarea anterior"
      },
      {
        "command": "easyLanguage.filterTasks",
        "title": "Easy: Filtrar tareas (ir a)"
      },
      {
        "command": "easyLanguage.showDeadlines",
        "title": "Easy: Mostrar fechas límite de tareas"
      },
      {
        "command": "easyLanguage.repeatTask",
        "title": "Easy: Repetir tarea (duplicar con fecha avanzada)"
      },
      {
        "command": "easyLanguage.cycleTaskStatus",
        "title": "Easy: Cambiar estado de tarea"
      },
      {
        "command": "easyLanguage.exportToMarkdown",
        "title": "Easy: Exportar a Markdown"
      }
    ],
    "configuration": {
      "title": "Easy Language",
      "properties": {
        "easyLanguage.decorationUpdateDelay": {
          "type": "number",
          "default": 300,
          "minimum": 0,
          "description": "Retardo en milisegundos para actualizar las decoraciones mientras se escribe."
        },
        "easyLanguage.dateFormat": {
          "type": "string",
          "enum": [
            "YYYY-MM-DD",
            "DD/MM/YYYY",
            "MM/DD/YYYY",
            "YYYY/MM/DD"
          ],
          "default": "YYYY-MM-DD",
          "description": "Formato de fecha que inserta el comando «Insert Current Date»."
        },
        "easyLanguage.completions.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Activa el autocompletado de etiquetas (#todo, #urgente…) y constructos (Tema:, fecha:, >>) en archivos Easy."
        },
        "easyLanguage.recurringTaskDays": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "Días que avanza la fecha al duplicar una tarea con «Easy: Repetir tarea» (1 = diaria, 7 = semanal)."
        },
        "easyLanguage.decorations.disabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "tema",
              "fecha",
              "subTituloDos",
              "subTituloUno",
              "titulo",
              "nuevoTexto",
              "negrita",
              "checkmark",
              "arroba",
              "validar",
              "check",
              "alta",
              "task",
              "media",
              "baja",
              "comentarioUno",
              "comentarioDos",
              "comentarioTres",
              "todo",
              "doing",
              "done",
              "blocked",
              "waiting"
            ]
          },
          "default": [],
          "description": "Decoraciones integradas que se desactivan (también acepta nombres de etiquetas personalizadas)."
        },
        "easyLanguage.decorations.backgroundColor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Sobrescribe el color de fondo de una decoración. Clave: nombre de decoración (p. ej. \"todo\"), valor: color hexadecimal (p. ej. \"#FF0000\")."
        },
        "easyLanguage.decorations.foregroundColor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Sobrescribe el color del texto de una decoración. Clave: nombre de decoración, valor: color hexadecimal."
        },
        "easyLanguage.customTags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "tag",
              "backgroundColor"
            ],
            "properties": {
              "tag": {
                "type": "string",
                "pattern": "^[#]?[a-zA-Z0-9_]+$",
                "description": "Nombre de la etiqueta (sin #; se acepta también con #). Ejemplo: \"urgente\"."
              },
              "backgroundColor": {
                "type": "string",
                "description": "Color de fondo (#RGB o #RRGGBB). Ejemplo: \"#FF00FF\"."
              },
              "foregroundColor": {
                "type": "string",
                "description": "Color del texto (#RGB o #RRGGBB). Opcional."
              },
              "hoverMessage": {
                "type": "string",
                "description": "Mensaje al pasar el cursor por la etiqueta. Opcional."
              }
            }
          },
          "default": [],
          "description": "Etiquetas personalizadas (#tag) con su propio color. Se resaltan igual que las integradas y no se tratan como títulos."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "npm run clean && npm run typecheck && npm run lint && npm test && node esbuild.js --production",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags",
    "pretest": "npm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.52.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.68.0"
  }
}
