{
  "name": "easy",
  "displayName": "Easy Language",
  "description": "A VS Code language for visual note-taking with colored tags (#todo, #doing, #done), formatted titles (#, ##, ###), date insertion, and keyboard shortcuts — designed for fast, organized plain-text notes.",
  "version": "0.1.0",
  "publisher": "JorgeDuarte",
  "author": {
    "name": "Jorge Duarte"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tu-usuario/EasyLanguage"
  },
  "engines": {
    "vscode": "^1.52.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "notes",
    "todo",
    "productivity",
    "easy",
    "color",
    "task management"
  ],
  "activationEvents": [
    "onLanguage:easy",
    "onLanguage:plaintext"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "easy",
        "path": "./easySnippets.json"
      }
    ],
    "languages": [
      {
        "id": "easy",
        "aliases": [
          "Easy",
          "easy"
        ],
        "extensions": [
          ".easy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "easy",
        "scopeName": "source.easy",
        "path": "./syntaxes/easy.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Easy Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/easy-color-theme.json"
      },
      {
        "label": "Easy Light",
        "uiTheme": "vs",
        "path": "./themes/easy-light-color-theme.json"
      }
    ],
    "keybindings": [
      {
        "command": "extension.insertText",
        "key": "ctrl+alt+d",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.insertSquare",
        "key": "ctrl+alt+i",
        "when": "editorTextFocus"
      },
      {
        "command": "extension.insertCurrentDate",
        "key": "ctrl+alt+f",
        "when": "editorTextFocus"
      }
    ],
    "commands": [
      {
        "command": "extension.insertText",
        "title": "Insert Check Mark"
      },
      {
        "command": "extension.insertSquare",
        "title": "Insert Square"
      },
      {
        "command": "extension.insertCurrentDate",
        "title": "Insert Current Date"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "lint": "eslint src test",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "pretest": "npm run lint",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@types/vscode": "1.52.0",
    "eslint": "^10.9.1",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.68.0"
  }
}
